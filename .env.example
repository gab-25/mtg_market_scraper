# Database (docker compose). Generate passwords with: python -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=mtg_market_scraper
# Read-only role Grafana uses to query the database; the sync's migrations create it when missing.
MTG_MARKET_SCRAPER_DB_READER_PASSWORD=change-me

# Grafana login (the only account; anonymous access and sign-up are off).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Running the sync outside docker compose:
# DATABASE_URL=postgresql://mtg_market_scraper:mtg_market_scraper@localhost:5432/mtg_market_scraper
# DATA_DIR=data
