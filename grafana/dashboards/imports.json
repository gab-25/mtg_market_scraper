{
  "uid": "imports",
  "title": "Imports",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "mtg_market_scraper"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Today",
      "description": "Whether today's guide is imported. The sync runs at about 04:30 and retries 4 times, 15 minutes apart.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH today AS (SELECT (now() AT TIME ZONE 'Europe/Rome')::date AS d),\nruns AS (\n  -- The attempts started today, in Cardmarket's time zone.\n  SELECT r.status FROM import_run r, today\n  WHERE (r.started_at AT TIME ZONE 'Europe/Rome')::date = today.d\n)\nSELECT CASE\n  WHEN EXISTS (SELECT 1 FROM import_run r, today WHERE r.guide_date = today.d AND r.status = 'ok') THEN 'Imported'\n  WHEN EXISTS (SELECT 1 FROM runs WHERE status = 'failed')\n    THEN 'Failing · ' || (SELECT count(*) FROM runs WHERE status = 'failed') || ' failed'\n  ELSE 'Not yet'\nEND AS \"Today\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^Imported$",
                "result": {
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^Failing.*",
                "result": {
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^Not yet$",
                "result": {
                  "color": "orange",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last import",
      "description": "When the latest attempt finished (Europe/Rome) and how it went.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(\n  (SELECT to_char(finished_at AT TIME ZONE 'Europe/Rome', 'YYYY-MM-DD HH24:MI') || ' · ' || status\n   FROM import_run ORDER BY id DESC LIMIT 1), 'never') AS \"Last import\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest prices",
      "description": "The most recent day with prices stored.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(\n  (SELECT to_char(max(day), 'YYYY-MM-DD') || CASE WHEN (now() AT TIME ZONE 'Europe/Rome')::date - max(day) > 0\n     THEN ' · ' || ((now() AT TIME ZONE 'Europe/Rome')::date - max(day)) || ' d ago' ELSE '' END FROM price HAVING max(day) IS NOT NULL),\n  '—') AS \"Latest prices\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed attempts",
      "description": "Failed attempts in the selected time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Failed attempts\"\nFROM import_run\nWHERE status = 'failed' AND $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Attempts per day",
      "description": "Import attempts by the day they started (Europe/Rome). More than one means retries.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', started_at AT TIME ZONE 'Europe/Rome') AS time,\n  count(*) FILTER (WHERE status = 'ok') AS \"OK\",\n  count(*) FILTER (WHERE status = 'failed') AS \"Failed\"\nFROM import_run\nWHERE $__timeFilter(started_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "OK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cards priced per day",
      "description": "Cards with a price stored for each day. A sudden drop points at a partial guide; backfilled days only cover the cards MTGJSON knows.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day::timestamp AS time, count(*) AS \"Cards priced\"\nFROM price\nWHERE $__timeFilter(day)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cards priced"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Missing days",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "description": "Days with no prices at all since the history starts, up to yesterday.",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  -- From the first stored day (or the range start) to yesterday: today is the Today panel's job.\n  SELECT greatest($__timeFrom()::date, min(day)) AS first,\n         least($__timeTo()::date, (now() AT TIME ZONE 'Europe/Rome')::date - 1) AS last\n  FROM price\n  HAVING min(day) IS NOT NULL\n)\nSELECT d::date AS \"Day\",\n  to_char(d, 'Dy') AS \"Weekday\",\n  CASE WHEN d::date >= (now() AT TIME ZONE 'Europe/Rome')::date - 90 THEN 'backfill (MTGJSON trend only)'\n       ELSE 'reimport --date ' || to_char(d, 'YYYY-MM-DD') || ' (only if archived)' END AS \"Fill with\"\nFROM bounds, generate_series(bounds.first, bounds.last, interval '1 day') d\nWHERE NOT EXISTS (SELECT 1 FROM price p WHERE p.day = d::date)\nORDER BY 1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No missing days.",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Weekday"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Attempts",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg_market_scraper"
      },
      "description": "Every import attempt in the selected time range, newest first.",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg_market_scraper"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  r.started_at AS \"Started\",\n  r.attempt AS \"Attempt\",\n  r.status AS \"Status\",\n  r.guide_date AS \"Guide\",\n  extract(epoch FROM r.finished_at - r.started_at) AS \"Duration\",\n  r.cards AS \"Cards\",\n  r.prices AS \"Prices\",\n  CASE WHEN r.status = 'ok' AND r.guide_date < (r.started_at AT TIME ZONE 'Europe/Rome')::date\n       THEN 'late guide' END AS \"Note\",\n  r.error AS \"Error\"\nFROM import_run r\nWHERE $__timeFilter(r.started_at)\nORDER BY r.started_at DESC, r.id DESC\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No import attempts in this time range.",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attempt"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Guide"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Note"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
