      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tcg_pulse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  -- The measures the sync computed from the stored history, for the chosen window.\n  SELECT r.id_product, r.price, r.gain_pct, r.r2, r.as_of, r.window_days\n  FROM rising r\n  WHERE r.window_days = $window AND r.foil = $foil\n    AND r.r2 >= 0.0 AND r.coverage >= 0.8 AND r.rising_steps >= 2 AND r.jump_share <= 0.5\n)\nSELECT count(*) AS \"Rising now\"\nFROM r\nWHERE r.price >= coalesce(nullif(replace(trim('$min_price'), ',', '.'), '')::numeric, 5)\n  AND r.gain_pct >= coalesce(nullif(replace(trim('$min_gain'), ',', '.'), '')::numeric, 15) / 100.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
