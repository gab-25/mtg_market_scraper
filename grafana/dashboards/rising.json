    {
      "id": 5,
      "type": "table",
      "title": "Rising cards",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tcg_pulse"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tcg_pulse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  -- The measures the sync computed from the stored history, for the chosen window.\n  SELECT r.id_product, r.price, r.gain_pct, r.r2, r.as_of, r.window_days\n  FROM rising r\n  WHERE r.window_days = $window AND r.foil = $foil\n    AND r.r2 >= 0.0 AND r.coverage >= 0.8 AND r.rising_steps >= 2 AND r.jump_share <= 0.5\n),\nranked AS (\n  SELECT r.*, c.name, c.id_expansion\n  FROM r\n  JOIN card c ON c.id_product = r.id_product\n  WHERE r.price >= coalesce(nullif(replace(trim('$min_price'), ',', '.'), '')::numeric, 5)\n    AND r.gain_pct >= coalesce(nullif(replace(trim('$min_gain'), ',', '.'), '')::numeric, 15) / 100.0\n  ORDER BY r.gain_pct DESC, c.name\n  LIMIT 500\n)\nSELECT\n  row_number() OVER (ORDER BY r.gain_pct DESC, r.name) AS \"#\",\n  r.name AS \"Card\",\n  coalesce(e.name, '#' || r.id_expansion) AS \"Expansion\",\n  r.price AS \"Price\",\n  r.gain_pct AS \"Gain\",\n  r.r2 AS \"R²\",\n  r.id_product::text AS id_product\nFROM ranked r\nLEFT JOIN expansion e ON e.id_expansion = r.id_expansion\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tcg_pulse"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  -- The measures the sync computed from the stored history, for the chosen window.\n  SELECT r.id_product, r.price, r.gain_pct, r.r2, r.as_of, r.window_days\n  FROM rising r\n  WHERE r.window_days = $window AND r.foil = $foil\n    AND r.r2 >= 0.0 AND r.coverage >= 0.8 AND r.rising_steps >= 2 AND r.jump_share <= 0.5\n),\nranked AS (\n  SELECT r.*, c.name, c.id_expansion\n  FROM r\n  JOIN card c ON c.id_product = r.id_product\n  WHERE r.price >= coalesce(nullif(replace(trim('$min_price'), ',', '.'), '')::numeric, 5)\n    AND r.gain_pct >= coalesce(nullif(replace(trim('$min_gain'), ',', '.'), '')::numeric, 15) / 100.0\n  ORDER BY r.gain_pct DESC, c.name\n  LIMIT 500\n)\n-- One series per card, labelled by id_product: the table draws each as its Trend sparkline.\nSELECT p.day::timestamp AS time, r.id_product::text AS id_product,\n       CASE WHEN $foil THEN p.trend_foil ELSE p.trend END AS \"Trend\"\nFROM ranked r\nJOIN price p ON p.id_product = r.id_product\n  AND p.day > r.as_of - r.window_days AND p.day <= r.as_of\nWHERE CASE WHEN $foil THEN p.trend_foil ELSE p.trend END IS NOT NULL\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
